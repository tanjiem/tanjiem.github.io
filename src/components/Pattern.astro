---
// A seed's pattern: concentric rings, one per result.
// A ring stays hollow (dotted) until its result exists, then it is drawn
// solid. Nothing here is ever filled with made-up data.
import { starPath } from '../lib/marks';
import type { Seed } from '../lib/world';

interface Props {
  seed: Seed;
}
const { seed } = Astro.props;
const { rings, state } = seed.data;
const unplanted = state === 'not yet planted';
const n = rings.length;
const step = n > 1 ? Math.min(24, 72 / (n - 1)) : 0;
const radii = rings.map((_, i) => 40 + i * step);
const done = rings.filter((r) => r.value).length;

const aria = unplanted
  ? 'This seed has no pattern yet.'
  : n === 0
    ? "This seed's rings are not defined yet."
    : `This seed's pattern: ${n} rings, ${done === 0 ? 'all still hollow because no results are in' : `${done} of ${n} filled in`}.`;
const caption = unplanted
  ? 'No pattern yet. Its rings are decided on the day it is planted.'
  : n === 0
    ? null
    : "This seed's pattern. Each ring fills in as its result arrives.";
---
<figure class="pattern">
  <svg role="img" aria-label={aria} width="260" height="260" viewBox="-130 -130 260 260">
    {unplanted ? (
      <>
        <circle r="112" class="ghost" />
        <path d={starPath(16)} class="star-hollow" />
      </>
    ) : (
      <>
        <circle r="118" class="ground" />
        <path d={starPath(20)} class="star" />
        {radii.map((r, i) => (
          <circle
            r={r}
            class:list={['ring', { filled: rings[i].value }]}
            style={`stroke: var(--ring-${(i % 4) + 1}); --c: ${(2 * Math.PI * r).toFixed(1)}`}
          />
        ))}
      </>
    )}
  </svg>
  {caption ? (
    <figcaption>{caption}</figcaption>
  ) : (
    <figcaption class="blank">[RING DEFINITIONS: one ring per result this seed will produce]</figcaption>
  )}
</figure>

<style>
  .pattern { margin: 0; display: flex; flex-direction: column; gap: var(--s-3); align-items: center; }
  svg { max-width: 100%; height: auto; }
  .ground { fill: var(--accent); fill-opacity: 0.05; }
  .star { fill: var(--seed); }
  .star-hollow { fill: var(--ground); stroke: var(--seed); stroke-width: 1.4; stroke-dasharray: 3 3; }
  .ghost { fill: none; stroke: var(--rule-strong); stroke-width: 1.5; stroke-dasharray: 1 6; }
  .ring { fill: none; stroke-width: 2; stroke-dasharray: 3 7; }
  .ring.filled {
    stroke-width: 3;
    stroke-dasharray: var(--c);
    stroke-dashoffset: 0;
    animation: draw 1.6s ease-out both;
  }
  @keyframes draw { from { stroke-dashoffset: var(--c); } }
  figcaption {
    font-family: var(--face-label);
    font-size: var(--size-label-sm);
    color: var(--text-quiet);
    text-align: center;
    max-width: 17rem;
    line-height: 1.3;
  }
</style>
