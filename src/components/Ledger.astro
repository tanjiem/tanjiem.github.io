---
// The notebook ledger: one typed row per entry. The filter is a set of plain
// links to pages built ahead of time, so it needs no JavaScript.
import Mark from './Mark.astro';
import { getWorld, pad, entryHref, url, type Seed } from '../lib/world';

interface Props {
  only?: Seed;
}
const { only } = Astro.props;
const { seeds, entries, entriesOf, seedOf } = await getWorld();
const filters = seeds.filter((s) => entriesOf(s).length > 0);
const rows = only ? entriesOf(only) : entries;
---
<nav class="filter" aria-label="Show entries about">
  <ul>
    <li><a href={url('/notebook/')} aria-current={!only ? 'page' : undefined}>[ ALL ]</a></li>
    {filters.map((s) => (
      <li>
        <a href={url(`/notebook/seed/${pad(s.data.number)}/`)} aria-current={only?.id === s.id ? 'page' : undefined}>
          [ SEED {pad(s.data.number)} ]
        </a>
      </li>
    ))}
  </ul>
</nav>

<ol class="ledger" aria-label={only ? `Entries about seed ${pad(only.data.number)}` : 'Every entry'}>
  {rows.map((e) => (
    <li>
      <a href={entryHref(e)}>
        <span class="num"><Mark kind="entry" state={e.data.state} size={14} />{pad(e.data.number)}</span>
        <span class="t">{e.data.title}</span>
        <span class="seed">seed {pad(seedOf(e).data.number)}</span>
        <span class:list={['when', { blank: e.data.state === 'written' && (!e.data.date || /^\[/.test(e.data.date)) }]}>
          {e.data.state === 'written' ? (e.data.date ?? '[DATE]') : 'unwritten'}
        </span>
      </a>
    </li>
  ))}
</ol>

<style>
  .filter ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .filter a {
    display: inline-block;
    white-space: nowrap;
    padding: var(--s-2) var(--s-3);
    font-family: var(--face-label);
    font-size: var(--size-label-lg);
    color: var(--text);
    text-decoration: none;
  }
  .filter a:hover { background: var(--accent); color: var(--ground); }
  .filter a[aria-current] { color: var(--accent); text-decoration: underline dashed; text-underline-offset: 6px; }
  .filter a[aria-current]:hover { color: var(--ground); }

  .ledger { list-style: none; margin: 0; padding: 0; border-bottom: var(--rule-dashed); }
  .ledger a {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-5);
    align-items: baseline;
    padding: 1.125rem 0;
    border-top: var(--rule-dashed);
    color: var(--text);
    text-decoration: none;
  }
  .num { flex: 0 0 3.5rem; color: var(--entry); display: inline-flex; align-items: center; gap: var(--s-2); }
  .t { flex: 999 1 22rem; font-size: 1.375rem; font-weight: 700; line-height: 1.3; }
  .ledger a:hover .t, .ledger a:focus-visible .t { text-decoration: underline; text-decoration-thickness: 1px; }
  .seed { flex: 0 0 9rem; color: var(--seed); }
  .when { flex: 0 0 7rem; color: var(--text-quiet); }
  @media (max-width: 40rem) {
    .t { flex-basis: calc(100% - 5rem); }
    .seed { flex: 0 0 auto; margin-left: 4.5rem; }
  }
</style>
