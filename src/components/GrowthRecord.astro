---
// A seed's growth record: a short checklist from planted to results published.
import type { Seed } from '../lib/world';

interface Props {
  seed: Seed;
}
const { growth } = Astro.props.seed.data;
const bracketed = (t: string) => /^\[.*\]$/.test(t.trim());
---
<section class="growth" aria-labelledby="growth-h">
  <h2 class="label" id="growth-h">Growth record</h2>
  <ul>
    {growth.map((g) => (
      <li>
        <span class:list={['box', { done: g.done }]} aria-hidden="true">{g.done ? '[x]' : '[ ]'}</span>
        <span class="visually-hidden">{g.done ? 'done: ' : 'not yet: '}</span>
        <span class:list={{ blank: bracketed(g.step) }}>{g.step}</span>
        {g.date && <span class:list={['date', { blank: bracketed(g.date) }]}> {g.date}</span>}
      </li>
    ))}
  </ul>
</section>

<style>
  .growth { display: flex; flex-direction: column; gap: var(--s-2); }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--s-1); }
  li { padding-left: 3.6ch; text-indent: -3.6ch; }
  .box { color: var(--text-quiet); margin-right: 0.6ch; white-space: pre; }
  .box.done { color: var(--seed); }
  .date { color: var(--text-quiet); }
</style>
