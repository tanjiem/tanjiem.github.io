---
// The top bar: the name, bracketed terminal links, the current place marked.
// On phones the links fold into a full-screen typed menu. It uses the HTML
// popover attribute, so it opens, shuts and takes Escape with no JavaScript.
import { url } from '../lib/world';
import { owner } from '../../site.config.mjs';

export type Place = 'map' | 'seeds' | 'notebook' | 'about' | 'none';
export type Crumb = { label: string; href?: string };

interface Props {
  place: Place;
  crumbs?: Crumb[];
  wide?: boolean;
}
const { place, crumbs = [], wide = false } = Astro.props;

const links = [
  { key: 'seeds', label: 'SEEDS', href: url('/#seeds') },
  { key: 'notebook', label: 'NOTEBOOK', href: url('/notebook/') },
  { key: 'about', label: 'ABOUT', href: url('/about/') },
  { key: 'resume', label: 'RESUME.PDF', href: url(owner.resume) },
];
const placeName = { map: 'the map', seeds: 'seeds', notebook: 'notebook', about: 'about', none: 'nowhere on the map' }[place];
---
<header class:list={['topbar page', { wide }]}>
  <div class="row">
    <a class="name" href={url('/')} aria-label="Tanjie McMeans, back to the map">tanjie mcmeans</a>

    <nav class="bar-links" aria-label="Main">
      <ul class="links">
        {links.map((l) => (
          <li>
            <a href={l.href} aria-current={l.key === place ? 'true' : undefined}>[ {l.label} ]</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="phone-bar">
      <a class="phone-resume" href={url(owner.resume)}>[ RESUME.PDF ]</a>
      <button class="menu-open" type="button" popovertarget="menu" aria-label="Open the menu">[ MENU ]</button>
    </div>
  </div>

  {crumbs.length > 0 && (
    <nav class="crumbs" aria-label="You are here">
      <ol>
        {crumbs.map((c, i) => (
          <li>
            {c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
            {i < crumbs.length - 1 && <span class="sep" aria-hidden="true">/</span>}
          </li>
        ))}
      </ol>
    </nav>
  )}

  <div id="menu" popover class="menu">
    <div class="row">
      <span class="name">tanjie mcmeans</span>
      <button class="menu-shut" type="button" popovertarget="menu" popovertargetaction="hide">[ SHUT ]</button>
    </div>
    <p class="label you">&gt; you are on: {placeName}</p>
    <nav aria-label="Menu">
      <ul class="menu-links">
        <li><a href={url('/')} aria-current={place === 'map' ? 'page' : undefined}>The map</a></li>
        {links.map((l) => (
          <li>
            <a href={l.href} aria-current={l.key === place ? 'true' : undefined}>{l.label.toLowerCase()}</a>
          </li>
        ))}
      </ul>
    </nav>
    <p class="write">
      write to me:{' '}
      {owner.email ? <a href={`mailto:${owner.email}`}>{owner.email}</a> : <span class="blank">[YOUR EMAIL]</span>}
    </p>
  </div>
</header>

<style>
  .topbar { padding-top: 1.375rem; }
  .topbar.wide { max-width: var(--page-wide); }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
    justify-content: space-between;
    align-items: center;
  }
  .name {
    font-family: var(--face-name);
    font-size: var(--size-name);
    color: var(--accent);
    text-decoration: none;
    min-height: 44px;
    display: flex;
    align-items: center;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-2);
    font-family: var(--face-label);
    font-size: var(--size-label-lg);
    letter-spacing: 0.04em;
  }
  .links a,
  .menu-open,
  .menu-shut {
    display: inline-block;
    white-space: nowrap;
    padding: var(--s-2) 0.625rem;
    color: var(--text);
    text-decoration: none;
  }
  .links a:hover,
  .menu-open:hover,
  .menu-shut:hover { background: var(--accent); color: var(--ground); }
  .links a:focus-visible::after,
  .menu-links a:focus-visible::after { content: '_'; }
  .links a[aria-current] {
    color: var(--accent);
    text-decoration: underline dashed;
    text-underline-offset: 6px;
  }
  .links a[aria-current]:hover { color: var(--ground); }

  .crumbs ol {
    display: flex;
    list-style: none;
    padding: 0;
    margin: 0;
    font-family: var(--face-label);
    font-size: var(--size-label-sm);
    color: var(--text-quiet);
  }
  .crumbs li { display: flex; }
  .crumbs .sep { padding: 0 0.6ch; }
  .crumbs a { color: var(--text-quiet); }
  .crumbs a:hover { color: var(--text); }

  button {
    font: inherit;
    font-family: var(--face-label);
    font-size: var(--size-label);
    letter-spacing: 0.04em;
    background: none;
    border: 0;
    cursor: pointer;
    min-height: 44px;
  }
  .phone-bar { display: none; }
  .phone-resume { font-family: var(--face-label); font-size: var(--size-label); letter-spacing: 0.04em; color: var(--text); text-decoration: none; white-space: nowrap; padding: var(--s-2) 0.625rem; min-height: 44px; display: inline-flex; align-items: center; }
  .phone-resume:hover { background: var(--accent); color: var(--ground); }

  /* the phone menu */
  .menu {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    border: 0;
    padding: 1.375rem var(--gutter) var(--s-6);
    background: var(--ground-raised);
    color: var(--text);
    flex-direction: column;
    gap: var(--s-5);
  }
  .menu:popover-open { display: flex; }
  .menu .name { font-size: 1.125rem; }
  .you { color: var(--text-quiet); }
  .menu-links {
    list-style: none;
    padding: 0;
    margin: 0;
    font-family: var(--face-label);
    font-size: var(--size-menu);
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }
  .menu-links li { border-top: var(--rule-dashed-strong); }
  .menu-links li:last-child { border-bottom: var(--rule-dashed-strong); }
  .menu-links a {
    display: block;
    padding: 0.625rem 0;
    color: var(--text);
    text-decoration: none;
  }
  .menu-links a[aria-current] { color: var(--accent); }
  .menu-links a[aria-current]::before { content: '> '; }
  .menu-links a[aria-current]::after { content: '_'; }
  .write { margin-top: auto; font-size: 0.875rem; color: var(--text-quiet); }

  @media (max-width: 47.99rem) {
    .bar-links { display: none; }
    .phone-bar { display: flex; gap: var(--s-1); margin-left: auto; }
    .name { font-size: 1.125rem; }
  }
</style>
